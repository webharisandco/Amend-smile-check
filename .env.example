# Copy this file to .env.local (for your PC) and fill in the values.
# On Hostinger / Vercel, add the same names as environment variables.
# NEVER commit the real .env.local file — it holds your secrets.

# ── MongoDB (leads, questions, settings) ────────────────────────────────
# MongoDB Atlas → your cluster → Connect → Drivers → copy the connection string.
# Put a database name before the "?", e.g. ...mongodb.net/amend-smile-check?retryWrites=true
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/amend-smile-check?retryWrites=true&w=majority

# ── Cloudinary (patient photos) ─────────────────────────────────────────
# Cloudinary console → Dashboard → "API environment variable".
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Folder the photos go into (optional).
CLOUDINARY_FOLDER=amend-smile-check

# ── Admin login ─────────────────────────────────────────────────────────
# Random secret that signs admin sessions — at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
# The FIRST admin account is created from these on first start.
# After that, change the username/password in Admin → Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── OpenAI (photo analysis) ─────────────────────────────────────────────
# Optional here — you can also paste the key in Admin → Settings instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Branding & links (shown on the public pages) ────────────────────────
NEXT_PUBLIC_CLINIC_NAME=Amend Dental Centre
NEXT_PUBLIC_WEBSITE_URL=https://amenddental.in/
NEXT_PUBLIC_BOOKING_URL=https://ig.me/m/amenddental?ref=w60450777
NEXT_PUBLIC_BRANCHES=Calicut · Kannur · Thalassery · Nadapuram · Kottakkal
